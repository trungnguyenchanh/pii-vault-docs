# Cấu hình Admin API (sao chép thành .env và điền giá trị thật)
ADMIN_API_ADDR=:8080
DATABASE_URL=postgres://readonly:password@localhost:5432/pii?sslmode=disable
JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
JWT_ISSUER=https://your-idp.example.com/
JWT_AUDIENCE=pii-admin
CORS_ALLOWED_ORIGINS=http://localhost:5173
